# -*- mode: ruby -*-
# vi: set ft=ruby :

# Single VM used as a Docker host.
# The Kubernetes cluster itself runs inside Docker containers via k3d.
# Two provisioners run in order:
#   1. install-tools.sh : installs Docker, kubectl and k3d
#   2. setup-cluster.sh : creates the cluster, installs Argo CD, applies the Application
Vagrant.configure("2") do |config|

  config.vm.box = "bento/ubuntu-24.04"
  config.vm.box_version = "202510.26.0"

  config.vm.define "redei-maS" do |server|
    server.vm.hostname = "redei-maS"
    server.vm.network "private_network", ip: "192.168.56.112"
    server.vm.provider "virtualbox" do |vb|
      vb.name = "redei-maS"
      vb.memory = "2048"
      vb.cpus = 2
    end
    server.vm.provision "shell", path: "scripts/install-tools.sh"
    server.vm.provision "shell", path: "scripts/setup-cluster.sh"
  end
end
